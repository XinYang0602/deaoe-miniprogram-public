<view class="page">
  <view class="demo">保修信息来自门店登记，具体服务范围以购机约定为准。</view>
  <view
    wx:if="{{error}}"
    class="error"
  >{{error}}
    <navigator
      url="/pages/my/index"
      open-type="switchTab"
      class="link"
    >前往我的登录 →</navigator>
  </view>
  <block wx:if="{{device}}">
    <view class="hero">
      <view class="muted">DEAOE · ELECTRONIC WARRANTY</view>
      <view class="heading">电子保修卡</view>
      <view>{{device.name}}</view>
      <view
        class="small"
        style="color:#bbc4ce"
      >{{device.model}}</view>
      <view class="stats">
        <view>
          <view>{{device.status}}</view>
          <view
            class="small"
            style="color:#bbc4ce"
          >有效至 {{device.end}}</view>
        </view>
      </view>
    </view>
    <view
      class="card"
      style="margin-top:24rpx"
    >
      <view class="line"><text>机身编号</text><text>{{device.sn}}</text></view>
      <view class="line"><text>保修开始</text><text>{{device.start}}</text></view>
      <view class="line"><text>保修结束</text><text>{{device.end}}</text></view>
      <view class="line"><text>销售门店</text><text>{{device.channel}}</text></view>
    </view>
    <button
      class="primary"
      bindtap="request"
    >为这台设备申请服务</button>
    <view class="section">关联服务记录</view>
    <view
      class="card"
      wx:for="{{records}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <view class="row"><text>{{item.type}}申请</text><text class="tag">{{item.status}}</text></view>
      <view class="small">预约 {{item.date}} →</view>
    </view>
    <view
      wx:if="{{!records.length}}"
      class="empty"
    >暂无服务记录</view>
  </block>
</view>
