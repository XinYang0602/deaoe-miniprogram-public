<view class="page devices-page">
  <view class="heading">我的设备</view>
  <view class="muted">设备信息与保修服务，一处查看</view>
  <view class="register-card">
    <image class="scan-symbol" src="/assets/ui/device-red.png" aria-hidden="true" />
    <view class="register-title">扫描设备二维码</view>
    <view class="register-copy">使用本人微信，扫描机身二维码</view>
    <button
      class="primary scan-button"
      bindtap="scan"
      loading="{{scanning}}"
      disabled="{{scanning}}"
    >打开相机扫一扫</button>
    <view
      wx:if="{{!registrationReady}}"
      class="pending-note"
    >扫码识别后，请联系门店完成绑定</view>
  </view>
  <view class="steps-card">
    <view class="steps-title">设备绑定指引</view>
    <view class="steps"><text>联系门店</text><text class="step-arrow" aria-hidden="true">›</text><text>核验资料</text><text class="step-arrow" aria-hidden="true">›</text><text>绑定设备</text></view>
    <view class="binding-note">保修期限以电子保修卡为准</view>
  </view>
  <view class="section">已绑定设备 <text class="device-count">{{items.length}}</text></view>
  <view
    wx:if="{{error}}"
    class="error"
  >{{error}}</view>
  <view
    wx:if="{{!loggedIn}}"
    class="empty"
  >登录后查看设备与保修卡<button bindtap="login">登录/注册</button>
  </view>
  <view
    wx:elif="{{loading}}"
    class="empty"
  >正在读取设备…</view>
  <view
    wx:elif="{{!items.length && !error}}"
    class="empty"
  ><view class="empty-title">暂无绑定设备</view><view class="small">请联系购机门店协助绑定</view>
  </view>
  <view
    class="card"
    wx:for="{{items}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="open"
  >
    <view class="row">
      <view class="title">{{item.name}}</view><text class="tag">{{item.status}}</text>
    </view>
    <view class="small">{{item.model}}</view>
    <view class="line"><text>机身编号</text><text>{{item.sn}}</text></view>
    <view class="line"><text>保修到期</text><text>{{item.end}}</text></view>
    <view class="link">查看电子保修卡 →</view>
  </view>
</view>
